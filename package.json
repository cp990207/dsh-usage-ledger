    "url": "git+https://github.com/cp990207/dsh-usage-ledger.git"
  },
  "homepage": "https://github.com/cp990207/dsh-usage-ledger#readme",
  "bugs": {
    "url": "https://github.com/cp990207/dsh-usage-ledger/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "usage",
    "tokens",
    "cost",
    "ledger"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
