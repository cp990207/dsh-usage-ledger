{
  "name": "dsh-usage-ledger",
  "version": "1.1.1",
  "description": "DeepSeek Harness plugin: a local usage ledger for token consumption, cache hit rate and estimated cost, per day, per model and per workspace.",
  "type": "module",
  "license": "MIT",
  "author": "白白酱 <cp990207@users.noreply.github.com> (https://github.com/cp990207)",
  "repository": {
